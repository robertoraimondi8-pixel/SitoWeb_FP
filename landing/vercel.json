{
  "rewrites": [
    {
      "source": "/api/analytics/:path*",
      "destination": "https://api.fantapronostic.com/api/analytics/:path*"
    },
    {
      "source": "/(fp-champions-league|champions-arena|community|community-league|super-league|lega|download|app|scarica|privacy)",
      "destination": "/$1/index.html"
    },
    {
      "source": "/((?!_vercel/|api/).*)",
      "destination": "/index.html"
    }
  ]
}
